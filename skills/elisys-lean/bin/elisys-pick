#!/usr/bin/env node
// elisys-pick: since v1.1.3 this makes ONE choice and reads nothing. The everyday launcher
// `elisys` is a dispatcher session on Sonnet 1M at high effort, so whatever the arguments or the
// queue say, the answer is always `sonnet[1m] high`. The queue-reading classifier of v1.1.0 to
// v1.1.2 (docs/build/deep from the waiting orders) is removed; the manual overrides are the
// launchers elisys-build, elisys-docs and elisys-deep, which do not call this script.
// The script is kept so anything that still calls it does not break. Output contract, unchanged:
// stdout is exactly "MODEL EFFORT" for a shell to `read`; any reasoning goes to stderr. Exit 0.
const MODEL = 'sonnet[1m]';
const EFFORT = 'high';
process.stderr.write(`  elisys-pick: fixed choice -> model ${MODEL}, effort ${EFFORT} (arguments and queue ignored)\n`);
process.stdout.write(`${MODEL} ${EFFORT}\n`);
